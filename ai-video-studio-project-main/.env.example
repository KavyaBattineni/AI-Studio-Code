# =========================================================================
# AI Video Studio - environment configuration
#
# Copy this file to .env and fill in what you need:
#   cp .env.example .env
#
# With APP_MODE=mock (the default) the app runs completely locally with no
# external accounts - every third-party integration below is optional.
# =========================================================================

# ---------- App mode ----------
# mock = MockEmailService / MockPaymentProvider / MockVideoProvider /
#        MockModerationProvider / MockAdProvider / MockStorageService are used.
# live = the app expects real credentials for every provider below.
APP_MODE=mock
SPRING_PROFILES_ACTIVE=dev

# ---------- Database ----------
DB_NAME=aivideo_studio
DB_URL=jdbc:mysql://localhost:3306/aivideo_studio?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# ---------- JWT ----------
# REQUIRED even in mock mode. Generate a real secret, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# ---------- Email (only used when APP_MODE=live; MockEmailService logs OTPs to the
# console instead when APP_MODE=mock) ----------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@aivideostudio.local

# ---------- AI video provider (only used when APP_MODE=live) ----------
AI_VIDEO_API_KEY=

# ---------- Payment gateway (only used when APP_MODE=live; MockPaymentProvider signs
# webhook payloads with this same secret when APP_MODE=mock, so it can be left as-is
# for local development) ----------
PAYMENT_KEY=
PAYMENT_SECRET=mock-dev-payment-secret-change-me

# ---------- Object storage / CDN (only used when APP_MODE=live) ----------
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- Rewarded-ad network (only used when APP_MODE=live) ----------
AD_PROVIDER_KEY=
